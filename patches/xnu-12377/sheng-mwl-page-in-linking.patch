+				}
+				kr = dyld_pager_peek(src_top_object, base_off + (vm_object_offset_t)i * PAGE_SIZE,
+				    (char *)fixup_buffer + (vm_offset_t)i * PAGE_SIZE, &fault_info);
+				if (kr != KERN_SUCCESS) {
+					retval = kr;
+					break;
+				}
+			}
+			if (retval == KERN_SUCCESS) {
+				if (fixup_page((vm_offset_t)fixup_buffer, base_userVA, pager) != KERN_SUCCESS) {
+					retval = KERN_FAILURE;
+				} else {
+					bcopy((const char *)fixup_buffer + (vm_offset_t)part * PAGE_SIZE, (char *)dst_vaddr, PAGE_SIZE);
+				}
+			}
 		} else if (fixup_page(dst_vaddr, userVA, pager) != KERN_SUCCESS) {
 			/* KDBG / printf was done under fixup_page() */
 			retval = KERN_FAILURE;
@@ -1253,6 +1417,9 @@ done:
