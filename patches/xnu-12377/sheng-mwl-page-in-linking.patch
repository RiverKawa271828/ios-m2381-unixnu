 		/*
 		 * Figure out what the original user virtual address was, based on the offset.
 		 */
@@ -1187,6 +1323,34 @@ retry_src_fault:
 				panic("%s(): Range not found for offset 0x%llx", __func__, (long long)cur_offset);
 			}
 			retval = KERN_FAILURE;
+		} else if (mwli_page_size > PAGE_SIZE) {
+			/* Assemble the whole fixup page, apply the chain once, copy out the requested part. */
+			vm_object_offset_t page_off = offset + cur_offset;
+			vm_object_offset_t base_off = page_off & ~(vm_object_offset_t)(mwli_page_size - 1);
+			uint32_t part = (uint32_t)((page_off - base_off) / PAGE_SIZE);
+			uint64_t base_userVA = userVA - (uint64_t)(page_off - base_off);
