+/*
+ * Fileset emission: donor components allocate through a one-argument
+ * IOMalloc KPI (kalloc_ext(KHEAP_DEFAULT, size, Z_VM_TAG_BT(Z_WAITOK,
+ * VM_KERN_MEMORY_IOKIT), NULL) plus a size-statistic add), which this
+ * kernel never builds out-of-line: in-tree callers expand the IOMalloc
+ * macro inline and no external wrapper survives into the binary. Provide
+ * the body so the rebinder can pair the donor import against it. The
+ * plain kalloc_ext accounting replaces the donor's separate size counter.
+ */
+__attribute__((used, noinline))
+void *
+unixnu_iomalloc_shim(vm_size_t size)
+{
+	return kalloc_ext(KHEAP_DEFAULT, size,
+	    Z_VM_TAG_BT(Z_WAITOK, VM_KERN_MEMORY_IOKIT), NULL).addr;
+}
+
