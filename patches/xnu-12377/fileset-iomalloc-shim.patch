--- a/osfmk/kern/kalloc.c
+++ b/osfmk/kern/kalloc.c
@@ -2443,6 +2443,74 @@
 }
 #endif /* XNU_PLATFORM_MacOSX */
 
+/*
+ * Fileset emission: donor components allocate through a one-argument
+ * IOMalloc KPI (kalloc_ext(KHEAP_DEFAULT, size, Z_VM_TAG_BT(Z_WAITOK,
+ * VM_KERN_MEMORY_IOKIT), NULL) plus a size-statistic add), which this
+ * kernel never builds out-of-line: in-tree callers expand the IOMalloc
+ * macro inline and no external wrapper survives into the binary. Provide
+ * the body so the rebinder can pair the donor import against it. The
+ * plain kalloc_ext accounting replaces the donor's separate size counter.
+ */
+__attribute__((used, noinline))
+void *
+unixnu_iomalloc_shim(vm_size_t size)
+{
+	return kalloc_ext(KHEAP_DEFAULT, size,
+	    Z_VM_TAG_BT(Z_WAITOK, VM_KERN_MEMORY_IOKIT), NULL).addr;
+}
+
+/*
+ * Same out-of-line gap on the free side: donor components free through the
+ * two-argument IOFree KPI (kfree_ext(KHEAP_DEFAULT, addr, size)) and through
+ * the mangled-view kfree_type_var tail (kfree_ext(kt_view | 1, ptr, size)),
+ * neither of which this kernel builds out of line for kext pairing. Provide
+ * both bodies; the kt_view is discarded in favor of KHEAP_DEFAULT so every
+ * donor allocation freed through these shims pairs with the
+ * unixnu_iomalloc_shim allocation zone.
+ *
+ * r84 (wall-82): the KHEAP_DEFAULT expectation above only holds for objects
+ * that stayed inside the IOMalloc/IOFree pair. Objects that crossed the
+ * fileset boundary - allocated by native APIs or by data-heap faces - can
+ * live in any kalloc heap, and forcing KHEAP_DEFAULT here trips
+ * kfree_heap_confusion_panic (r82/r83 screens, crc 0x94673e52 / 0xa4355c2c,
+ * size 192 in heap data.*; the caller chain donor IOFree veneer -> this shim
+ * -> kfree_ext was captured by the kfree-ext-panic-caller patch). Mirror the
+ * kfree_ext body minus the heap expectation instead: identical behavior for
+ * default-heap pairs, correct for objects that live elsewhere.
+ */
+__attribute__((used, noinline))
+void
+unixnu_iofree_shim(void *addr, vm_size_t size)
+{
+	vm_size_t bucket_size, oob_offs;
+	zone_t z;
+
+	if (addr == NULL) {
+		return;
+	}
+	if (size <= KHEAP_MAX_SIZE) {
+		bucket_size = zone_element_size(addr, &z, true, &oob_offs);
+		if (bucket_size && size + oob_offs <= bucket_size) {
+			addr = (char *)addr - oob_offs;
+			__nosan_bzero(addr, bucket_size);
+			zfree_ext(z, z->z_stats, addr, ZFREE_PACK_SIZE(bucket_size, size));
+			return;
+		}
+	}
+	/* Large or foreign element: the original path - kfree_ext carries its own
+	 * size-confusion panics and the large-free branch. */
+	kfree_ext(KHEAP_DEFAULT, addr, size);
+}
+
+__attribute__((used, noinline))
+void
+unixnu_kfreevar_shim(void *kt_view, void *ptr, vm_size_t size)
+{
+	(void)kt_view;
+	kfree_ext(KHEAP_DEFAULT, ptr, size);
+}
+
 void *
 kalloc_data_external(vm_size_t size, zalloc_flags_t flags);
