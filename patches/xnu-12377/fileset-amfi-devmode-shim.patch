+/*
+ * Fileset emission: donor AppleMobileFileIntegrity's developer-mode
+ * configuration (ConfigurationSettings.cpp) probes /arm-io/soc-misc and,
+ * failing that, waits 30 seconds for an ApplePMGRNub service before it
+ * latches the boot policy register. This platform has neither the Apple
+ * SoC-misc node nor a PMGR provider, and IOKit matching never publishes
+ * one, so the donor path always expires and trips the "AMFI: No PMGR?"
+ * assert (ConfigurationSettings.cpp:388; the BPR query/set siblings at
+ * :367/:372 panic the same way when the SoC-misc service exists but
+ * refuses). Provide the benign absence path: report the configuration as
+ * complete and leave developer-mode state at its power-on defaults
+ * (disabled), which is what the donor achieves by calling
+ * disable_developer_mode here on the same outcome.
+ */
+__attribute__((used, noinline))
+int
+unixnu_amfi_devmode_config(void)
+{
+	return 0;
+}
