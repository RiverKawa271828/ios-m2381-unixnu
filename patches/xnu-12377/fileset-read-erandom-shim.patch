+/*
+ * Fileset emission: donor components (sandbox among them) call the static
+ * read_erandom directly, but this compiler inlines it into every in-tree
+ * caller, so the kernel has no out-of-line body for the rebinder to pair the
+ * donor call sites against. Provide one. The wrapper keeps the exact
+ * read_erandom semantics (defer to the kernel PRNG once prng_ready, DRBG
+ * before that) and deliberately lacks read_random's extra prng_funcs.refresh.
+ */
+__attribute__((used, noinline))
+void
+unixnu_fileset_read_erandom(void * buf, size_t nbytes)
+{
+	read_erandom(buf, nbytes);
+}
