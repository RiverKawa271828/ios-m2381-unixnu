# r94: sheng T0SZ_USER transplant -- the 47-bit user VA for the 4K arm64e bcm2837 config.
# Extracted verbatim from zzzz-sheng-ipados27-bringup-core.patch (r52-era, shelved): the
# T0SZ_USER face only (pmap geometry + TCR rework + early-boot TTBR0 + fault mask + VM strip).
# Gate: BCM2837 && !__ARM_16K_PG__ && __arm64e__ matches exactly our kernel build.
# sheng-desktop-proven; our r93 device verdict pinned the T0SZ mismatch as the wall-86 root cause.
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 72d3561..e8db5d8 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -357,6 +357,12 @@ arm_init(
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+#if T0SZ_USER != T0SZ_BOOT
+	/* Final TTBR0 size before the first pointer is signed (see TCR_EL1_KVA_ENTRY). */
+	set_tcr(TCR_EL1_KVA_ENTRY);
+	flush_core_tlb();
+#endif /* T0SZ_USER != T0SZ_BOOT */
+
 	arm_slide_rebase_and_sign_image();
 
 	arm_static_if_init(args);


diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 9760c9c..2eadcf0 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -335,6 +335,50 @@ const struct page_table_attr * const native_pt_attr = &pmap_pt_attr_16k;
 const struct page_table_attr * const native_pt_attr = &pmap_pt_attr_4k;
 #endif /* !__ARM_16K_PG__ */
 
+#if T0SZ_USER != T0SZ_BOOT
+/* User pmaps: the 4K layout with a TTBR0 root at T0SZ_USER (L0 for a 47-bit range). */
+const struct page_table_attr pmap_pt_attr_4k_user = {
+	.pta_level_info = pmap_table_level_info_4k,
+	.pta_root_level = (T0SZ_USER - 16) / 9,
+	.pta_commpage_level = PMAP_TT_L1_LEVEL,
+	.pta_max_level  = PMAP_TT_L3_LEVEL,
+	.pta_ops = &native_pt_ops,
+	.ap_ro = ARM_PTE_AP(AP_RORO),
+	.ap_rw = ARM_PTE_AP(AP_RWRW),
+	.ap_rona = ARM_PTE_AP(AP_RONA),
+	.ap_rwna = ARM_PTE_AP(AP_RWNA),
+	.ap_xn = ARM_PTE_PNX | ARM_PTE_NX,
+	.ap_x = ARM_PTE_PNX,
+	.pta_page_size  = 4096,
+	.pta_pagezero_size = 4096,
+	.pta_page_shift = 12,
+	.pta_va_valid_mask = ARM_PTE_REGION_MASK(T0SZ_USER),
+};
+const struct page_table_attr * const native_user_pt_attr = &pmap_pt_attr_4k_user;
+_Static_assert((ARM_PTE_REGION_MASK(T0SZ_USER) >> ARM_4K_TT_L0_SHIFT) + 1 == PMAP_ROOT_ALLOC_SIZE / sizeof(tt_entry_t),
+    "the user L0 root must fit the root allocation size");
+
+static inline uint64_t
+pmap_user_tcr(uint64_t tcr)
+{
+	return (tcr & ~((TCR_TSZ_MASK << TCR_T0SZ_SHIFT) | TCR_EPD0_DISABLE)) | (T0SZ_USER << TCR_T0SZ_SHIFT);
+}
+
+/*
+ * Turn TTBR0 walks on at the user range. The caller has pointed TTBR0 at the empty table
+ * (or a user root), so no walk sees a table of the boot format.
+ */
+MARK_AS_PMAP_TEXT void
+pmap_apply_user_tcr(void)
+{
+	const uint64_t tcr = get_tcr();
+	if (tcr != pmap_user_tcr(tcr)) {
+		set_tcr(pmap_user_tcr(tcr));
+		flush_core_tlb();
+	}
+}
+#endif /* T0SZ_USER != T0SZ_BOOT */
+
 
 #if DEVELOPMENT || DEBUG
 int vm_footprint_suspend_allowed = 1;
@@ -2277,6 +2321,8 @@ pmap_bootstrap(
 	/*
 	 *	Initialize the kernel pmap.
 	 */
+	/* First: the pmap's type selects its page table attributes (see T0SZ_USER). */
+	kernel_pmap->type = PMAP_TYPE_KERNEL;
 #if ARM_PARAMETERIZED_PMAP
 	kernel_pmap->pmap_pt_attr = native_pt_attr;
 #endif /* ARM_PARAMETERIZED_PMAP */
@@ -2314,6 +2360,10 @@ pmap_bootstrap(
 
 	pmap_max_asids = pmap_compute_max_asids();
 #if HAS_16BIT_ASID
+	/* UniXNU: TCR_EL1.AS is set (TCR_EL1_ASID); on a core with 8-bit ASIDs it is RES0 and the ASIDs above 255 would alias. */
+	if (((__builtin_arm_rsr64("ID_AA64MMFR0_EL1") >> 4) & 0xf) != 2) {
+		panic("pmap: HAS_16BIT_ASID, but ID_AA64MMFR0_EL1 0x%llx has no 16-bit ASIDs", __builtin_arm_rsr64("ID_AA64MMFR0_EL1"));
+	}
 	asid_chunk_size = MAX_HW_ASIDS;
 #else
 	pmap_asid_plru = (pmap_max_asids > MAX_HW_ASIDS);
@@ -6000,7 +6050,8 @@ wimg_to_pte(unsigned int wimg, pmap_paddr_t pa)
 		pte |= ARM_PTE_NX | ARM_PTE_PNX;
 		break;
 	case VM_WIMG_RT:
-		if (is_dram_addr(pa)) {
+		/* DRAM outside the gDramBase window (more than one physical range) is still managed memory: Normal, not Device. */
+		if (is_dram_addr(pa) || pa_valid(pa)) {
 			pte = ARM_PTE_ATTRINDX(CACHE_ATTRINDX_RT);
 		} else {
 #if HAS_FEAT_XS
@@ -6040,7 +6091,8 @@ wimg_to_pte(unsigned int wimg, pmap_paddr_t pa)
 		pte |= ARM_PTE_NX | ARM_PTE_PNX;
 		break;
 	case VM_WIMG_WCOMB:
-		if (is_dram_addr(pa)) {
+		/* DRAM outside the gDramBase window (more than one physical range) is still managed memory: Normal, not Device. */
+		if (is_dram_addr(pa) || pa_valid(pa)) {
 			pte = ARM_PTE_ATTRINDX(CACHE_ATTRINDX_WRITECOMB);
 		} else {
 #if HAS_FEAT_XS
@@ -7962,6 +8014,12 @@ pmap_switch_user_ttb(pmap_t pmap, pmap_cpu_data_t *cpu_data_ptr)
 
 
 	if (pmap != kernel_pmap) {
+#if T0SZ_USER != T0SZ_BOOT
+		if (__improbable(get_tcr() != pmap_user_tcr(get_tcr()))) {
+			set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
+			pmap_apply_user_tcr();
+		}
+#endif /* T0SZ_USER != T0SZ_BOOT */
 		set_mmu_ttb((pmap->ttep & TTBR_BADDR_MASK) | (((uint64_t)pmap->hw_asid) << TTBR_ASID_SHIFT));
 	} else if (!pmap_user_ttb_is_clear()) {
 		pmap_clear_user_ttb_internal();
@@ -7972,6 +8030,9 @@ MARK_AS_PMAP_TEXT void
 pmap_clear_user_ttb_internal(void)
 {
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
+#if T0SZ_USER != T0SZ_BOOT
+	pmap_apply_user_tcr();
+#endif /* T0SZ_USER != T0SZ_BOOT */
 }
 
 void
@@ -10949,6 +11010,14 @@ pmap_batch_set_cache_attributes_internal(
 
 			pvh_unlock(pai);
 
+			/* UniXNU: as pmap_set_cache_attributes() does, a page leaving write-back loses its lines (pmap_sync_page_attributes_phys).
+			 * This SoC does not keep a page's lines coherent across a change of its attributes: a page made write-combined
+			 * would keep the dirty lines of its cacheable zero-fill, and a later device read through a coherent path could see
+			 * them over data written past the cache. */
+			if (wimg_bits_new != wimg_bits_prev && wimg_bits_new != VM_WIMG_RT) {
+				pmap_sync_wimg(pn, wimg_bits_prev, wimg_bits_new);
+			}
+
 			page_index++;
 
 #if XNU_MONITOR
@@ -12965,7 +13034,7 @@ pmap_user_va_bits(pmap_t pmap __unused)
 	uint64_t tcr_value = pmap_get_pt_attr(pmap)->pta_tcr_value;
 	return 64 - ((tcr_value >> TCR_T0SZ_SHIFT) & TCR_TSZ_MASK);
 #else
-	return 64 - T0SZ_BOOT;
+	return 64 - T0SZ_USER;
 #endif
 }
 
@@ -15301,3 +15370,76 @@ pmap_pending_preemption(void)
 	return _pmap_pending_preemption_real();
 }
 #endif /* SCHED_HYGIENE_DEBUG && (DEBUG || DEVELOPMENT) */
+
+
+/*
+ * UniXNU: the mappings of a managed page in CPU pmaps other than the kernel's, and the first one's pmap and address. A driver that
+ * frees pages it handed out through physical-range mappings (NativeAdreno's BO views, which hold no reference to the pages) asks
+ * first: a page a user task still maps is kept rather than freed under the mapping (pmap_assert_free), and not disconnected either,
+ * since the mapping would fault the page in again from its next owner.
+ */
+unsigned int native_pmap_user_mappings(ppnum_t ppnum, void **first_pmap, uint64_t *first_va, char *first_name);
+unsigned int
+native_pmap_user_mappings(ppnum_t ppnum, void **first_pmap, uint64_t *first_va, char *first_name /* 17 bytes, the process's */)
+{
+	const pmap_paddr_t pa = ptoa(ppnum);
+	unsigned int count = 0;
+
+	if (first_pmap) {
+		*first_pmap = NULL;
+	}
+	if (first_va) {
+		*first_va = 0;
+	}
+	if (first_name) {
+		first_name[0] = 0;
+	}
+	if (!pa_valid(pa)) {
+		return 0;
+	}
+	const unsigned int pai = pa_index(pa);
+	pvh_lock(pai);
+	pv_entry_t **pvh = pai_to_pvh(pai);
+	pt_entry_t *ptep = PT_ENTRY_NULL;
+	pv_entry_t *pvep = PV_ENTRY_NULL;
+	int index = 0;
+	if (pvh_test_type(pvh, PVH_TYPE_PTEP)) {
+		ptep = pvh_ptep(pvh);
+	} else if (pvh_test_type(pvh, PVH_TYPE_PVEP)) {
+		pvep = pvh_pve_list(pvh);
+	}
+	while (ptep != PT_ENTRY_NULL || pvep != PV_ENTRY_NULL) {
+		if (pvep != PV_ENTRY_NULL) {
+			ptep = pve_get_ptep(pvep, index);
+		}
+		if (ptep != PT_ENTRY_NULL && !pvh_ptep_is_iommu(ptep)) {
+			pmap_t pmap = ptep_get_pmap(ptep);
+			if (pmap != kernel_pmap) {
+				if (count == 0) {
+					if (first_pmap) {
+						*first_pmap = pmap;
+					}
+					if (first_va) {
+						*first_va = (uint64_t)ptep_get_va(ptep);
+					}
+#if MACH_ASSERT
+					if (first_name) {
+						strlcpy(first_name, pmap->pmap_procname, 17);
+					}
+#endif /* MACH_ASSERT */
+				}
+				count++;
+			}
+		}
+		if (pvep == PV_ENTRY_NULL) {
+			break;
+		}
+		ptep = PT_ENTRY_NULL;
+		if (++index == PTE_PER_PVE) {
+			index = 0;
+			pvep = pve_next(pvep);
+		}
+	}
+	pvh_unlock(pai);
+	return count;
+}


