+#if defined(HAS_APPLE_PAC)
+/*
+ * The corecrypto provider in this collection is the donor's binary. It calls the
+ * entropy callback with the type discriminator its toolchain assigned to
+ * cckprng_getentropy (0xbcad - the value -fptrauth-function-pointer-type-
+ * discrimination gives this printf-shaped type), while this compiler signs a
+ * function-pointer argument with the zero discriminator. Sign the pointer the
+ * way the caller authenticates it.
+ */
+static cckprng_getentropy
+unixnu_donor_getentropy(cckprng_getentropy callback)
+{
+	return (cckprng_getentropy)ptrauth_sign_unauthenticated((void *)callback,
+	           ptrauth_key_function_pointer, 0xbcad);
+}
+#else
+#define unixnu_donor_getentropy(callback) (callback)
+#endif /* defined(HAS_APPLE_PAC) */
+
