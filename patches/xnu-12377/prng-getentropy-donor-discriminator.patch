--- a/osfmk/prng/prng_random.c
+++ b/osfmk/prng/prng_random.c
@@ -328,6 +328,44 @@
 	read_erandom(buffer, numBytes);
 }

+#if defined(HAS_APPLE_PAC)
+/*
+ * The corecrypto provider in this collection is the donor's binary. It calls the
+ * entropy callback with the type discriminator its toolchain assigned to
+ * cckprng_getentropy (0xbcad - the value -fptrauth-function-pointer-type-
+ * discrimination gives this printf-shaped type), while this compiler signs a
+ * function-pointer argument with the zero discriminator. Sign the pointer the
+ * way the caller authenticates it.
+ *
+ * Wall 31 (Mac lane, Xcode 27.2): typing the wrapper parameter and return as
+ * cckprng_getentropy made Apple clang lower the unannotated function
+ * reference -> annotated type conversion as pacia(0xbcad) followed by an
+ * autia with the zero discriminator, a "validation" that always fails and
+ * traps on FPAC hardware (panic "PAC failure ... while authing x16" at
+ * register_and_init_prng; the Linux clang build of the same source emits
+ * only strip + sign and boots). Keep the wrapper boundary untyped and
+ * launder the result into the annotated slot through memcpy, so no
+ * annotated conversion is ever materialized; the explicit strip and sign
+ * builtins are the whole transformation.
+ */
+static void *
+unixnu_donor_getentropy(void *callback)
+{
+	/*
+	 * Strip first: a function reference in this kernel already arrives
+	 * signed under the zero-discriminator convention, and signing that
+	 * value again stacks a second signature the donor's blraa can never
+	 * validate (the r82 batch round proved this idiom on the sysctl and
+	 * kmod entry fixes).
+	 */
+	return ptrauth_sign_unauthenticated(
+	           ptrauth_strip(callback, ptrauth_key_function_pointer),
+	           ptrauth_key_function_pointer, 0xbcad);
+}
+#else
+#define unixnu_donor_getentropy(callback) (callback)
+#endif /* defined(HAS_APPLE_PAC) */
+
 void
 register_and_init_prng(struct cckprng_ctx *ctx, const struct cckprng_funcs *funcs)
 {
@@ -340,7 +377,10 @@
 	prng_funcs = *funcs;

 	uint64_t nonce = ml_get_timebase();
-	prng_funcs.init_with_getentropy(prng_ctx, MAX_CPUS, sizeof(kprngseed), kprngseed, sizeof(nonce), &nonce, entropy_provide, NULL);
+	void *donor_getentropy_value = unixnu_donor_getentropy((void *)entropy_provide);
+	cckprng_getentropy donor_getentropy;
+	__builtin_memcpy(&donor_getentropy, &donor_getentropy_value, sizeof(donor_getentropy));
+	prng_funcs.init_with_getentropy(prng_ctx, MAX_CPUS, sizeof(kprngseed), kprngseed, sizeof(nonce), &nonce, donor_getentropy, NULL);
 	prng_funcs.initgen(prng_ctx, boot_cpu_id);
 	prng_ready = 1;

