--- a/bsd/kern/kern_sig.c
+++ b/bsd/kern/kern_sig.c
@@ -115,6 +115,10 @@
 #include <mach/exception.h>
 #include <mach/task.h>
 #include <mach/thread_act.h>
+#include <mach/arm/thread_status.h>
+
+/* arm64 saved-state accessors; the declaration lives in osfmk/arm/thread.h, which this TU does not pull in. */
+extern struct arm_saved_state *get_user_regs(thread_t);
 #include <libkern/OSAtomic.h>
 
 #include <sys/sdt.h>
@@ -1825,6 +1829,59 @@
 
 			/* We dropped/consumed the reference in set_thread_exit_reason() */
 			signal_reason = OS_REASON_NULL;
+			/*
+			 * r89 (wall-86 capture, 2026-11-08): r87's launchd died in dyld
+			 * pre-main with OS_REASON_SIGNAL / SIGSEGV (namespace 2, subcode
+			 * 0xb) after the shared-region sign gate fix let the PAC auth
+			 * pass. The pre-death kernel residency sat in
+			 * AppleFSCompressionTypeZlib demand-paging the dyld cache, but the
+			 * userspace fault site has no capture channel: the console ring
+			 * is closed once boot_progress goes active, a signal exit never
+			 * renders the panic screen, and the reader window only carries
+			 * kernel-side rows. This block only runs for a signal that is
+			 * about to be fatal (the psignal_internal mirror condition
+			 * above), so demand-page noise never lands here. Record the site
+			 * like the PAC-fail capture does: one console line, the two wide
+			 * rows (BootLog emits them into the boot-diag page on every
+			 * writer tick), and a 10s hold with IRQs enabled so the 2s writer
+			 * snapshots them. pc/lr/sp/fp come from the faulting thread's
+			 * saved user state; "code" is the mach exception code and
+			 * uu_subcode the fault address set by handle_ux_exception() just
+			 * before threadsignal(); the saved-state far is printed next to
+			 * the subcode as a cross-check. Diagnostic only; the fatal path
+			 * proceeds unchanged.
+			 */
+			{
+				extern void boot_progress_pac_wide(const char *, const char *);
+				struct arm_saved_state *ss = get_user_regs(sig_actthread);
+				uint64_t pc = (uint64_t)get_saved_state_pc(ss);
+				uint64_t lr = (uint64_t)get_saved_state_lr(ss);
+				uint64_t sp = (uint64_t)get_saved_state_sp(ss);
+				uint64_t fp = (uint64_t)get_saved_state_fp(ss);
+				uint64_t far = (uint64_t)get_saved_state_far(ss);
+				uint64_t t0, v, freq;
+				char r0[112], r1[112];
+
+				printf("SEGFAIL p%d sig=%d code=%llx sub=%llx pc=%llx "
+				    "lr=%llx sp=%llx fp=%llx far=%llx\n",
+				    proc_getpid(p), signum, (unsigned long long)code,
+				    (unsigned long long)uth->uu_subcode, pc, lr, sp, fp, far);
+
+				snprintf(r0, sizeof r0, "SEGFAIL p%d s%d c=%llx sc=%llx "
+				    "pc=%llx lr=%llx", proc_getpid(p), signum,
+				    (unsigned long long)code,
+				    (unsigned long long)uth->uu_subcode, pc, lr);
+				snprintf(r1, sizeof r1, "SEGFAIL sp=%llx fp=%llx far=%llx",
+				    sp, fp, far);
+				boot_progress_pac_wide(r0, r1);
+
+				__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(freq));
+				__asm__ volatile("mrs %0, cntpct_el0" : "=r"(t0));
+				__asm__ volatile("msr daifclr, #2"); /* IRQs on: writer runs */
+				do {
+					__asm__ volatile("mrs %0, cntpct_el0" : "=r"(v));
+				} while (v - t0 < freq * 10);
+			}
 		}
 	}
 
