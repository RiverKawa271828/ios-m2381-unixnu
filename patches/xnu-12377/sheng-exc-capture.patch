# 2026-11-09 (r91, wall-86 diagnostic): the r90 window re-read (with the
# message-buffer blocks the slot-only parse missed) overturned two verdicts at
# once: the printf->msgbuf->window channel is alive until the death (sheng-*
# rows and the SEGFAIL line are all in blocks 1..32), and the dyld pager's
# 16 KiB fixup assembly genuinely ran - sheng-src/sheng-peek/sheng-mwl
# (fmt=0xc, hdr_page_size=0x4000), a 12-entry chain walk in fixupPageAuth64
# and one sheng-sign (a_key=0 strong sign) all fired 0.12 s before the same
# libobjc isa SIGSEGV. What is still invisible: whether the map_with_linking_np
# syscall itself is on the live path (the pager can assemble pages for plain
# faults too), what the fixups wrote into the delivered page, and what the
# dying launchd thread had in its registers/frames. This patch adopts the
# sheng bring-up exception diagnostic (exception_triage hook for pid 1 and the
# sheng-exc-name list: full registers, the eight instructions around pc, the
# far's physical page and MMU attributes, a 32-frame user backtrace) plus the
# cache-parser input capture (the 0x46618-0x1bba4 return-pair trigger with a
# bounded copyin, FNV-64 of the whole input and head/tail words) - the channel
# adaptation is none: printf already reaches the window. The kern_exit.c hook
# keeps sheng's critical-exit backtrace (tag = process name, so a launchd
# exit still arms the cache-input capture). The pager/syscall stations are
# uncapped and extended (written values, per-page completion, syscall
# entry/exit) so the next window shows the whole MWL story. Diagnostic only.
diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index 72ef3c5..b86b393 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1988,6 +1988,16 @@ proc_handle_critical_exit(proc_t p, int rv)
 
 	char *exit_reason_desc = exit_reason_get_string_desc(p->p_exit_reason);
 
+#if __arm64__
+	/* Bring-up: the user backtrace of a boot-critical exit (launchd dying on a
+	 * signal passes here after the fatal path; tag = process name so the
+	 * cache-input capture arms on "launchd" as in the sheng lane). */
+	if (current_proc() == p) {
+		extern void sheng_dump_user_backtrace(const char *tag);
+		sheng_dump_user_backtrace(proc_best_name(p));
+	}
+#endif /* __arm64__ */
+
 	if (p->p_exit_reason == OS_REASON_NULL) {
 		printf("pid %d exited -- no exit reason available -- (signal %d, exit %d)\n",
 		    proc_getpid(p), WTERMSIG(rv), WEXITSTATUS(rv));
