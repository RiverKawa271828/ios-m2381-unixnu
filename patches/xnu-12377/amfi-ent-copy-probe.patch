+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+extern unsigned long vm_kernel_slide;
+extern void (*sheng_death_flush_hook)(void);
+
+/*
+ * Fileset emission: donor AppleMobileFileIntegrity's entitlements copy
+ * panics (OSEntitlements.cpp:863, "failed to create OSDictionary copy:
+ * 14") when the blob deserializer under the copy helper fails.
+ * s108 static RE (24A446 donor, dis24.py) overturned the half-filled-
+ * header verdict: the record at [x1+0xd0] is a self-consistent
+ * CoreEntitlements TLV record {type/flags +0, DER TLV ptr +8,
+ * TLV length +0x10, dictionary tag +0x18, content ptr +0x20, content
+ * length +0x28} -- tag 0xa000000000000010 = DER byte 0xb0 ([16] ctx
+ * constructed), len 0x332c, content = len-4, and the 23F84 OS image
+ * shows the real blob shape {0x70 wrapper}[{02 01 01 version}][0xb0
+ * dict{0x30 pair{0c key, value}}]. H/K/L/M parse this record
+ * correctly, so the death must be the CONTENT bytes or the pointer
+ * lifetime, neither visible to v2. v3 hexdumps the TLV start
+ * ([holder+8]) and the content start ([holder+0x20]) -- csb_mem is
+ * wired, so a fault here is itself the lifetime verdict; every row
+ * is flushed before the next deref so a bad step cannot erase the
+ * rows before it. Same BL station, same original-first call.
+ */
+__attribute__((used, noinline))
+int
+unixnu_amfi_ent_copy_probe(void *holder, void *out)
+{
+	uintptr_t target = (uintptr_t)(0xfffffff009264c90ull + vm_kernel_slide);
+	int ret;
+
+	/* Plain blr: the helper lands on bti c and balances its own PAC
+	 * frame, so a raw-address call from this side is well-formed. */
+	{
+		register uintptr_t x0 __asm__("x0") = (uintptr_t)holder;
+		register uintptr_t x1 __asm__("x1") = (uintptr_t)out;
+		register uintptr_t x16 __asm__("x16") = target;
+
+		__asm__ volatile("blr x16"
+		    : "+r"(x0)
+		    : "r"(x1), "r"(x16)
+		    : "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+		    "x11", "x12", "x13", "x14", "x15", "x17", "x30", "memory");
+		ret = (int)x0;
+	}
+
+	if (ret != 0) {
+			/* Row 1 (r106/r107-proven): the words G itself reads. */
+			kprintf("unixnu-amfi-entcopy: ret=%d holder=%p type=%llx tag=%llx shape=%llx\n",
+			    ret, holder,
+			    *(const unsigned long long *)((const char *)holder + 0x8),
+			    *(const unsigned long long *)((const char *)holder + 0x10),
+			    *(const unsigned long long *)((const char *)holder + 0x20));
+			if (sheng_death_flush_hook != NULL) {
+				sheng_death_flush_hook();
+			}
+			/* v3 (A17): record tail (+0x30) and content length first. */
+			kprintf("unixnu-amfi-entcopy: end7=%llx clen=%llx\n",
+			    *(const unsigned long long *)((const char *)holder + 0x30),
+			    *(const unsigned long long *)((const char *)holder + 0x28));
+			/* The 0xb0 TLV header+first body words (expect b0 82 xx xx). */
+			{
+				const unsigned char *tp = (const unsigned char *)(uintptr_t)
+				    *(const unsigned long long *)((const char *)holder + 0x8);
+				kprintf("unixnu-amfi-entcopy: tlv=%llx %llx\n",
+				    *(const unsigned long long *)tp,
+				    *(const unsigned long long *)(tp + 8));
+			}
+			if (sheng_death_flush_hook != NULL) {
+				sheng_death_flush_hook();
+			}
+			/* The dict content start (expect 30 pair 0c key ...). */
+			{
+				const unsigned char *cp = (const unsigned char *)(uintptr_t)
+				    *(const unsigned long long *)((const char *)holder + 0x20);
+				kprintf("unixnu-amfi-entcopy: cnt=%llx %llx\n",
+				    *(const unsigned long long *)cp,
+				    *(const unsigned long long *)(cp + 8));
+			}
+			if (sheng_death_flush_hook != NULL) {
+				sheng_death_flush_hook();
+			}
+			kprintf("unixnu-amfi-entcopy: isa=%llx htag=%llx\n",
+			    *(const unsigned long long *)(const char *)holder,
+			    *(const unsigned long long *)((const char *)holder + 0x18));
+			{
+				proc_t p = current_proc();
+
+				if (p != NULL) {
+					kprintf("unixnu-amfi-entcopy: victim pid=%d comm=%s\n",
+					    p->p_pid, p->p_comm);
+				}
+			}
+			if (sheng_death_flush_hook != NULL) {
+				sheng_death_flush_hook();
+			}
+	}
+	return ret;
+}
+
+__attribute__((used, noinline))
+int
+unixnu_amfi_ent_copy_probe_l(void *container, void *cont, void *out)
+{
+	uintptr_t target = (uintptr_t)(0xfffffff009262690ull + vm_kernel_slide);
+	int ret;
+	unsigned long long pre_gate;
+
+	/* A18 blade-2: station on K's bl L (donor 0x92639cc -> L-stub
+	 * 0x9262690, word 0x97fffb31). The stub's gate reads [x0+0x10]
+	 * (0x9262694) and accepts SET 0x2000000000000011 / dict
+	 * 0xa000000000000010, rejecting everything else as normal control
+	 * flow (r108 verdict: the record is legal DER and the L gate
+	 * passes, so the kill sits deeper in the element walk). Mirroring
+	 * that comparison keeps routine gate rejects silent; only a
+	 * gate-passed container that still fails is worth a row. The
+	 * writer thread copies the message buffer every 2s round and the
+	 * F-station probe flushes at death, so rows need no flush here:
+	 * zero UFS work keeps this station behavior-transparent on the
+	 * hot path. */
+	pre_gate = *(const unsigned long long *)((const char *)container + 0x10);
+
+	/* Plain blr: the stub lands on bti c and builds its own frame; the
+	 * PAC-signed continuation in x1 passes through untouched. */
+	{
+		register uintptr_t x0 __asm__("x0") = (uintptr_t)container;
+		register uintptr_t x1 __asm__("x1") = (uintptr_t)cont;
+		register uintptr_t x2 __asm__("x2") = (uintptr_t)out;
+		register uintptr_t x16 __asm__("x16") = target;
+
+		__asm__ volatile("blr x16"
+		    : "+r"(x0)
+		    : "r"(x1), "r"(x2), "r"(x16)
+		    : "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+		    "x11", "x12", "x13", "x14", "x15", "x17", "x30", "memory");
+		ret = (int)x0;
+	}
+
+	if (ret != 0 && (pre_gate == 0x2000000000000011ull ||
+	    pre_gate == 0xa000000000000010ull)) {
+		const char *c = (const char *)container;
+
+		kprintf("unixnu-amfi-entcopy-l: ret=%d ent=%p cont=%llx out=%llx\n",
+		    ret, container, (unsigned long long)cont, (unsigned long long)out);
+		kprintf("unixnu-amfi-entcopy-l: pre c10=%llx c18=%llx c20=%llx c28=%llx\n",
+		    pre_gate,
+		    *(const unsigned long long *)(c + 0x18),
+		    *(const unsigned long long *)(c + 0x20),
+		    *(const unsigned long long *)(c + 0x28));
+		/* M advances the walk cursor in place (0x9261108); the post
+		 * bytes show how far the element walk got, and [c-8] is K's
+		 * record base (x21) whenever x21 = container-8. */
+		kprintf("unixnu-amfi-entcopy-l: post c8=%llx c18=%llx cm8=%llx\n",
+		    *(const unsigned long long *)(c + 0x8),
+		    *(const unsigned long long *)(c + 0x18),
+		    *(const unsigned long long *)(c - 8));
+		{
+			proc_t p = current_proc();
+
+			if (p != NULL) {
+				kprintf("unixnu-amfi-entcopy-l: victim pid=%d comm=%s\n",
+				    p->p_pid, p->p_comm);
+			}
+		}
+	}
+	return ret;
+}
