+__attribute__((used, noinline))
+int
+unixnu_amfi_entconv_probe2(void *osstring)
+{
+	uintptr_t target = (uintptr_t)(0xfffffff0092714f8ull + vm_kernel_slide);
+	int ret;
+
+	if (osstring == NULL) {
+		kprintf("unixnu-amfi-entconv: f1-handed-NULL osstring=%p\n", osstring);
+		{
+			proc_t p = current_proc();
+
+			if (p != NULL) {
+				kprintf("unixnu-amfi-entconv: pre-f2 victim pid=%d comm=%s\n",
+				    p->p_pid, p->p_comm);
+			}
+		}
+	}
+	{
+		register uintptr_t x0 __asm__("x0") = (uintptr_t)osstring;
+		register uintptr_t x16 __asm__("x16") = target;
+
+		/* x16 MUST be declared as an input operand: a bare register
+		 * variable is only a hint and clang is free to never load it
+		 * (r110 first-boot verdict: the blr jumped to leftover x16
+		 * garbage, 2s instruction fetch abort with lr in this probe). */
+		__asm__ volatile("blr x16"
+		    : "+r"(x0)
+		    : "r"(x16)
+		    : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9",
+		    "x10", "x11", "x12", "x13", "x14", "x15", "x17",
+		    "x30", "memory");
+		ret = (int)x0;
+	}
+
+	if (ret == 0 && osstring != NULL) {
+		kprintf("unixnu-amfi-entconv: f2=NULL ostr=%p flg=%x s8=%llx s10=%llx\n",
+		    osstring,
+		    *(const unsigned int *)((const char *)osstring + 0xc),
+		    *(const unsigned long long *)((const char *)osstring + 8),
+		    *(const unsigned long long *)((const char *)osstring + 0x10));
+		kprintf("unixnu-amfi-entconv: f2 heap=%s zstart=%d tag=%d\n",
+		    KHEAP_DATA_PRIVATE[0].kh_name, KHEAP_DATA_PRIVATE[0].kh_zstart,
+		    KHEAP_DATA_PRIVATE[0].kh_tag);
+		{
+			proc_t p = current_proc();
+
+			if (p != NULL) {
+				kprintf("unixnu-amfi-entconv: f2 victim pid=%d comm=%s\n",
+				    p->p_pid, p->p_comm);
+			}
+		}
+	}
+	return ret;
+}
+/*
+ * r111 blades 5/6 (value-face confirmation): the r110-rev2 window closed the
+ * key face (conv rows absent = F1/F2 live) and the value face statically
+ * end-to-end (K dispatch/cb1/cb2/C1/M/shells/GOT all clean), leaving two
+ * suspects only: an inner M reject (stack-guard false trip, fixed by
+ * kernel-stack-shift-guard.patch) or corrupted blob bytes past pair[01]
+ * (the v3 rows only ever verified the first 16 bytes). These stations sit
+ * on the two intra-callback bl K sites -- donor 0x9263af8 (cb1 value
+ * conversion, word 0x97ffff78) and 0x9263b6c (cb2 sequence recursion, word
+ * 0x97ffff5b) -- pass x0/x1 through to K, and print the element record head
+ * only when K returns NULL: CEType@+0 (which value class died), tag@+0x18,
+ * content@+0x20, clen@+0x28, plus the victim. With the stack-shift fix live,
+ * silence here + a boot past the 72 s wall = the guard verdict confirmed;
+ * rows here name the exact element class the converter refuses.
+ */
+__attribute__((used, noinline))
+int
+unixnu_amfi_entval_probe1(void *record, void *handlers)
+{
+	uintptr_t target = (uintptr_t)(0xfffffff0092638d8ull + vm_kernel_slide);
+	int ret;
+
+	{
+		register uintptr_t x0 __asm__("x0") = (uintptr_t)record;
+		register uintptr_t x1 __asm__("x1") = (uintptr_t)handlers;
+		register uintptr_t x16 __asm__("x16") = target;
+
+		__asm__ volatile("blr x16"
+		    : "+r"(x0), "+r"(x1)
+		    : "r"(x16)
+		    : "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9",
+		    "x10", "x11", "x12", "x13", "x14", "x15", "x17", "x30",
+		    "memory");
+		ret = (int)x0;
+	}
+
+	if (ret == 0 && record != NULL) {
+		kprintf("unixnu-amfi-entval: v1=NULL rec=%p type=%llx tag=%llx ptr=%llx len=%llx\n",
+		    record,
+		    *(const unsigned long long *)record,
+		    *(const unsigned long long *)((const char *)record + 0x18),
+		    *(const unsigned long long *)((const char *)record + 0x20),
+		    *(const unsigned long long *)((const char *)record + 0x28));
+		kprintf("unixnu-amfi-entval: guard=%u victim pid=%d comm=%s\n",
+		    unixnu_kernel_stack_shift,
+		    (current_proc() ? current_proc()->p_pid : -1),
+		    (current_proc() ? current_proc()->p_comm : "?"));
+		if (sheng_death_flush_hook != NULL) {
+			sheng_death_flush_hook();
+		}
+	}
+	return ret;
+}
