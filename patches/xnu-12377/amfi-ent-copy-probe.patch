+/*
+ * A19 blades 3/4 (r110): s99 instruction-level verdict -- the ret=14 is
+ * produced ONLY by the dict-walk element callback (donor 0x9263a90):
+ * path 1 = the pair's key tag != UTF8 (0x0c), path 2 = the key-string
+ * converter returning NULL. The converter wrapper (donor 0x9264b64) is
+ * exactly two calls: F1 = OSString::withCString(data, len) via auth
+ * stub 0x92714d8, then F2 = OSSymbol::withString(osstring) via auth
+ * stub 0x92714f8; the F2 result is the returned key object. All four
+ * GOT bindings were bit-verified correct against the r109 map
+ * (reviewed pairs to our native OSString::withCString/
+ * OSSymbol::withString), so the NULL is a real return from our own
+ * implementations. The stations sit on the wrapper's two bl words
+ * (donor 0x9264b80 word 0x94003256, 0x9264b88 word 0x9400325c) and
+ * print only on failure paths: blade-3 on an F1 NULL (with the key
+ * bytes), blade-4 when F1 handed in a NULL osstring (which would have
+ * panicked inside withString had we not been here) or when the F2
+ * result is NULL (with the OSString flags/string pointer and the
+ * kalloc-data heap health -- the withCString NULL exits are
+ * kalloc_data(23) and MetaClass::alloc, both of which bottom out in
+ * the KHEAP_DATA_PRIVATE zones). Cold-path kprintf only; the F-station
+ * probe flushes at death so the rows reach the window msg region.
+ */
+__attribute__((used, noinline))
+int
+unixnu_amfi_entconv_probe1(void *data, unsigned long long len)
+{
+	uintptr_t target = (uintptr_t)(0xfffffff0092714d8ull + vm_kernel_slide);
+	int ret;
+
+	{
+		register uintptr_t x0 __asm__("x0") = (uintptr_t)data;
+		register uintptr_t x1 __asm__("x1") = (uintptr_t)len;
+		register uintptr_t x16 __asm__("x16") = target;
+
+		__asm__ volatile("blr x16"
+		    : "+r"(x0), "+r"(x1)
+		    : "r"(x16)
+		    : "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9",
+		    "x10", "x11", "x12", "x13", "x14", "x15", "x17", "x30",
+		    "memory");
+		ret = (int)x0;
+	}
+
+	if (ret == 0 && data != NULL) {
+		kprintf("unixnu-amfi-entconv: f1=NULL data=%p len=%llx str=%llx %llx\n",
+		    data, len,
+		    *(const unsigned long long *)data,
+		    *(const unsigned long long *)((const char *)data + 8));
+		kprintf("unixnu-amfi-entconv: f1 heap=%s zstart=%d tag=%d\n",
+		    KHEAP_DATA_PRIVATE[0].kh_name, KHEAP_DATA_PRIVATE[0].kh_zstart,
+		    KHEAP_DATA_PRIVATE[0].kh_tag);
+		{
+			proc_t p = current_proc();
+
+			if (p != NULL) {
+				kprintf("unixnu-amfi-entconv: f1 victim pid=%d comm=%s\n",
+				    p->p_pid, p->p_comm);
+			}
+		}
+	}
+	return ret;
+}
