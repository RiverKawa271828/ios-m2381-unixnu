--- a/osfmk/kern/stack.c
+++ b/osfmk/kern/stack.c
@@ -154,6 +154,17 @@
 static vm_offset_t stack_alloc_internal(void);
 static void stack_free_stack(vm_offset_t);

+/*
+ * log2 of the stack allocation alignment (stack_addr_mask + 1). Donor
+ * components measure the stack room left as sp & ((1 << shift) - 1) and read
+ * a boot-filled page-shift global for the shift, which is only right where
+ * the lower guard pages keep the stack base aligned (16 KiB pages). On the
+ * 4 KiB kernel the stack starts 8 KiB into a 32 KiB-aligned allocation, so
+ * the page shift (14) gives false out-of-stack errors at fixed call depths.
+ * XnuPrelink binds those donor reads here (reviewed data record in its
+ * fixtures; r111 revives the s52 recon-staged entry).
+ */
+__attribute__((used)) SECURITY_READ_ONLY_LATE(uint32_t) unixnu_kernel_stack_shift;
 static void
 stack_init(void)
 {
@@ -173,7 +184,14 @@
 		    (void *) kernel_stack_size, PAGE_SIZE);
 	}

-	stack_addr_mask = roundup_pow2(kernel_stack_size) - 1;
+	/*
+	 * Align the whole allocation (two guard pages below the stack, one above)
+	 * rather than the stack size alone: with 4 KiB pages the stack then starts
+	 * at least 8 KiB above an aligned address, so sp & stack_addr_mask never
+	 * comes near zero inside a stack (see unixnu_kernel_stack_shift).
+	 */
+	stack_addr_mask = roundup_pow2(kernel_stack_size + ptoa(3)) - 1;
 	kernel_stack_mask = ~stack_addr_mask;
+	unixnu_kernel_stack_shift = (uint32_t)__builtin_ctzl(stack_addr_mask + 1);
 }
 STARTUP(TUNABLES, STARTUP_RANK_MIDDLE, stack_init);
