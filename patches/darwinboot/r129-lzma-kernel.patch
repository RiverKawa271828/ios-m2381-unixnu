diff --git a/DarwinBootPkg/Driver/DarwinBoot.c b/DarwinBootPkg/Driver/DarwinBoot.c
index 0417112..85d7331 100644
--- a/DarwinBootPkg/Driver/DarwinBoot.c
+++ b/DarwinBootPkg/Driver/DarwinBoot.c
@@ -16,6 +16,7 @@
 #include "BootVideo.h"
 #include "PackedRamdisk.h"
 #include "WindowSize.h"
+#include "Lzma/LzmaDec.h"
 
 #define WINDOW_SIZE  SIZE_256MB
 #define BLOCK_SIZE   SIZE_2MB
@@ -112,6 +113,126 @@ Done:
   return Status;
 }
 
+//
+// LZMA-alone kernel members (payload step kernel_compression = "lzma"): a
+// 13-byte header of 5 props bytes followed by the uncompressed size as LE64,
+// written by the Python lzma FORMAT_ALONE encoder with the size patched in.
+// A Mach-O starts with feedfacf (first byte 0xCF), so the props byte 0x5D
+// alone identifies a compressed member; every other file stays a plain
+// kernel and passes through untouched. The decoder uses the destination
+// buffer as its dictionary window, so the scratch only carries the
+// probability tables (the payload encoder pins a 16 MiB dictionary, which
+// then only limits match distances).
+//
+#define LZMA_HEADER_SIZE  13
+#define LZMA_PROPS_BYTE   0x5D
+#define LZMA_SCRATCH_SIZE SIZE_64KB
+
+typedef struct {
+  ISzAlloc  Functions;    // first member: LzmaDecode receives &Functions
+  VOID     *Buffer;
+  UINTN     Remaining;
+} LZMA_ALLOC;
+
+STATIC VOID *EFIAPI LzmaPoolAlloc (ISzAllocPtr Pool, size_t Size)
+{
+  LZMA_ALLOC  *Private;
+  VOID        *Address;
+
+  Private = (LZMA_ALLOC *)Pool;
+  Size    = ALIGN_VALUE (Size, sizeof (UINT64));
+  if (Private->Remaining < Size) { return NULL; }
+  Address            = Private->Buffer;
+  Private->Buffer    = (VOID *)((UINT8 *)Address + Size);
+  Private->Remaining -= Size;
+  return Address;
+}
+
+STATIC VOID EFIAPI LzmaPoolFree (ISzAllocPtr Pool, VOID *Address)
+{
+  (VOID)Pool;
+  (VOID)Address;    // bump allocation; the whole scratch is freed by the caller
+}
+
+STATIC
+UINT64
+LzmaDecodedSize (CONST UINT8 *Data)
+{
+  UINT64  Size;
+  INTN    Index;
+
+  Size = 0;
+  for (Index = LZMA_HEADER_SIZE - 1; Index >= 5; Index--) {
+    Size = LShiftU64 (Size, 8) + Data[Index];
+  }
+
+  return Size;
+}
+
+STATIC
+EFI_STATUS
+ExpandKernel (VOID **Image, UINTN *ImageSize)
+{
+  LZMA_ALLOC   Pool;
+  VOID         *Scratch;
+  VOID         *Decoded;
+  UINT64       ExpectedSize;
+  SizeT        DecodedSize;
+  SizeT        SourceSize;
+  ELzmaStatus  LzmaStatus;
+  SRes         LzmaResult;
+
+  CONST UINT8 *Data = (CONST UINT8 *)*Image;
+  if ((*ImageSize < LZMA_HEADER_SIZE + 32) || (Data[0] != LZMA_PROPS_BYTE)) {
+    return EFI_SUCCESS;    // a plain kernel: ParseKernel owns the rejection
+  }
+
+  ExpectedSize = LzmaDecodedSize (Data);
+  if ((ExpectedSize == MAX_UINT64) || (ExpectedSize < SIZE_1MB) || (ExpectedSize > KERNEL_LIMIT)) {
+    Print (L"DARWINBOOT: kernel lzma header claims %lu bytes; refused\n", ExpectedSize);
+    return EFI_LOAD_ERROR;
+  }
+
+  Scratch = AllocatePool (LZMA_SCRATCH_SIZE);
+  Decoded = AllocatePool ((UINTN)ExpectedSize);
+  if ((Scratch == NULL) || (Decoded == NULL)) {
+    if (Scratch != NULL) { FreePool (Scratch); }
+    if (Decoded != NULL) { FreePool (Decoded); }
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  Pool.Functions.Alloc = LzmaPoolAlloc;
+  Pool.Functions.Free  = LzmaPoolFree;
+  Pool.Buffer          = Scratch;
+  Pool.Remaining       = LZMA_SCRATCH_SIZE;
+  DecodedSize          = (SizeT)ExpectedSize;    // in/out: the produced output size on return
+  SourceSize           = (SizeT)(*ImageSize - LZMA_HEADER_SIZE);
+  LzmaResult = LzmaDecode (
+                 (Byte *)Decoded,
+                 &DecodedSize,
+                 (Byte *)Data + LZMA_HEADER_SIZE,
+                 &SourceSize,
+                 Data,
+                 LZMA_PROPS_SIZE,
+                 LZMA_FINISH_END,
+                 &LzmaStatus,
+                 &Pool.Functions
+                 );
+  FreePool (Scratch);
+  if ((LzmaResult != SZ_OK) || ((UINT64)DecodedSize != ExpectedSize)) {
+    Print (L"DARWINBOOT: kernel lzma decode failed: %d, %lu of %lu bytes (status %lu)\n",
+           (UINT32)LzmaResult, (UINT64)DecodedSize, ExpectedSize, (UINT64)LzmaStatus);
+    FreePool (Decoded);
+    return EFI_LOAD_ERROR;
+  }
+
+  Print (L"DARWINBOOT: kernel lzma %lu -> %lu bytes\n", (UINT64)*ImageSize, (UINT64)DecodedSize);
+  FreePool (*Image);
+  *Image     = Decoded;
+  *ImageSize = (UINTN)DecodedSize;
+  return EFI_SUCCESS;
+}
+
 STATIC
 EFI_STATUS
 ParseKernelHeader (CONST UINT8 *Data, UINTN Size, UINTN Header, KERNEL *Kernel)
@@ -642,6 +763,8 @@ Boot (
   if (EFI_ERROR (Status)) { return Status; }
   Status = ReadFile (Root, Request->KernelPath, KERNEL_LIMIT, &Image, &ImageSize);
   if (EFI_ERROR (Status)) { goto Fail; }
+  Status = ExpandKernel (&Image, &ImageSize);
+  if (EFI_ERROR (Status)) { goto Fail; }
   Status = ParseKernel (Image, ImageSize, &Kernel);
   if (EFI_ERROR (Status)) { goto Fail; }
   Length = StrSize (Request->KernelPath);
