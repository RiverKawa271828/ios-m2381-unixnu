diff --git a/Test/test-lzma-kernel.py b/Test/test-lzma-kernel.py
new file mode 100644
index 0000000..92b7b27
--- /dev/null
+++ b/Test/test-lzma-kernel.py
@@ -0,0 +1,131 @@
+#!/usr/bin/env python3
+"""Compile the production LZMA kernel expander and check round-trips and refusals."""
+import ctypes
+import io
+import lzma
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+source = (ROOT / 'DarwinBootPkg/Driver/DarwinBoot.c').read_text()
+
+slice_start = source.index('#define LZMA_HEADER_SIZE')
+slice_end = source.index('STATIC\nEFI_STATUS\nParseKernelHeader')
+body = source[slice_start:slice_end]
+
+preamble = '''
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "Lzma/LzmaDec.h"
+typedef uint8_t UINT8; typedef uint32_t UINT32; typedef uint64_t UINT64;
+typedef size_t UINTN; typedef ptrdiff_t INTN; typedef void VOID; typedef int BOOLEAN;
+#define STATIC static
+#define CONST const
+#define EFIAPI
+#define TRUE 1
+#define FALSE 0
+typedef int EFI_STATUS;
+#define EFI_SUCCESS 0
+#define EFI_LOAD_ERROR 1
+#define EFI_OUT_OF_RESOURCES 9
+#define EFI_ERROR(s) ((s) != EFI_SUCCESS)
+#define MAX_UINT64 UINT64_MAX
+#define SIZE_1MB 0x100000ULL
+#define SIZE_64KB 0x10000ULL
+#define KERNEL_LIMIT 0x10000000ULL
+#define ALIGN_VALUE(a, b) ((a) + ((b) - 1) & ~((b) - 1))
+static UINT64 LShiftU64 (UINT64 v, UINTN n) { return v << n; }
+VOID *AllocatePool (UINTN n) { return malloc(n); }
+VOID FreePool (VOID *p) { free(p); }
+#define Print(...) ((VOID)0)
+'''
+
+with tempfile.TemporaryDirectory(prefix='darwinboot-lzma-') as tmp:
+    work = Path(tmp)
+    (work / 'expander.c').write_text(preamble + body + '''
+static VOID *g_Image;
+static UINTN g_Size;
+int check (VOID *p, UINTN n) { VOID *i = p; UINTN s = n; int r = ExpandKernel (&i, &s); g_Image = i; g_Size = s; return r; }
+UINTN last_size (VOID) { return g_Size; }
+VOID *last_image (VOID) { return g_Image; }
+''')
+    subprocess.run(['clang', '-Wall', '-Wextra', '-Werror', '-I', str(ROOT / 'DarwinBootPkg/Driver'),
+                    str(work / 'expander.c'), str(ROOT / 'DarwinBootPkg/Driver/Lzma/LzmaDec.c'),
+                    '-shared', '-fPIC', '-o', str(work / 'expander.so')], check=True)
+    lib = ctypes.CDLL(str(work / 'expander.so'))
+    lib.check.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
+    lib.last_image.restype = ctypes.c_void_p
+    lib.last_size.restype = ctypes.c_size_t
+    lib.AllocatePool.restype = ctypes.c_void_p
+    lib.AllocatePool.argtypes = [ctypes.c_size_t]
+    lib.FreePool.argtypes = [ctypes.c_void_p]
+
+    def expand(blob):
+        # ExpandKernel frees the input buffer on a successful swap, so the
+        # harness owns the copy via the shim allocator (malloc/free inside the
+        # same shared object; ctypes calls into this libc's free crash here).
+        buf = lib.AllocatePool(len(blob))
+        ctypes.memmove(buf, bytes(blob), len(blob))
+        status = lib.check(ctypes.c_void_p(buf), len(blob))
+        return status, lib.last_image(), lib.last_size(), buf
+
+    def compress(payload):
+        """The payload step's encoding: LZMA1 alone format, size patched into the header."""
+        filters = [{'id': lzma.FILTER_LZMA1, 'preset': 9 | lzma.PRESET_EXTREME, 'dict_size': 1 << 24}]
+        out = io.BytesIO()
+        with lzma.LZMAFile(out, 'wb', format=lzma.FORMAT_ALONE, filters=filters) as f:
+            f.write(payload)
+        blob = bytearray(out.getvalue())
+        struct.pack_into('<Q', blob, 5, len(payload))
+        return bytes(blob)
+
+    plain_kernel = bytearray(4096)
+    struct.pack_into('<I', plain_kernel, 0, 0xfeedfacf)
+
+    # 1. A plain kernel passes through byte-identical.
+    status, image, size, buf = expand(plain_kernel)
+    assert status == 0, f'plain kernel refused: {status}'
+    assert size == len(plain_kernel), 'plain kernel resized'
+    assert image == buf, 'plain kernel buffer swapped'
+    lib.FreePool(buf)
+
+    # 2. A compressed kernel expands to its original bytes.
+    payload = bytes(range(256)) * 8192 + b'UNIXNU-DARWINBOOT-LZMA-TEST' * 4096   # 2 MiB+, compressible
+    status, image, size, buf = expand(compress(payload))
+    assert status == 0, f'valid member refused: {status}'
+    assert size == len(payload), f'expanded to {size} bytes'
+    assert ctypes.string_at(image, size) == payload, 'expanded bytes differ'
+    lib.FreePool(image)    # the compressed copy was freed by the swap
+
+    # 3. Corrupted stream.
+    blob = bytearray(compress(payload))
+    blob[len(blob) // 2] ^= 0xFF
+    status, _, _, buf = expand(bytes(blob))
+    assert status == 1, f'corrupt stream accepted: {status}'
+    lib.FreePool(buf)
+
+    # 4. A member claiming more than KERNEL_LIMIT.
+    blob = bytearray(compress(payload))
+    struct.pack_into('<Q', blob, 5, 0x10000000 + 1)   # KERNEL_LIMIT in the shim
+    status, _, _, buf = expand(bytes(blob))
+    assert status == 1, f'oversized member accepted: {status}'
+    lib.FreePool(buf)
+
+    # 5. The unknown-size header the raw Python encoder leaves behind.
+    blob = bytearray(compress(payload))
+    struct.pack_into('<Q', blob, 5, 0xFFFFFFFFFFFFFFFF)
+    status, _, _, buf = expand(bytes(blob))
+    assert status == 1, f'unknown-size member accepted: {status}'
+    lib.FreePool(buf)
+
+    # 6. The known-size header is what LzmaDecodedSize reads back.
+    blob = bytearray(compress(payload))
+    assert struct.unpack_from('<Q', blob, 5)[0] == len(payload)
+
+print('test-lzma-kernel: 6 checks ok')
