/uefi-sheng

# 本地会话工作区（符号化脚本 / 日志窗 / 器件快照；方法论沉淀在 docs/STATE.md §4）
/temp/

# 设备仓本地缓存（firmware/fixture；CI 走 orphan 分支 device-m2381 不受影响）
/devices/*/*/.cache/

# 本地构建/刷写产物
artifacts/*
!artifacts/README.md
devices/*/out/
devices/*/esp/out/

# Python
__pycache__/
*.pyc

# 临时
*.tmp
*.log
out/

# Local build staging (re-derivable; the audit ABI json is regenerated per display build)
