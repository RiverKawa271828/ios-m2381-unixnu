diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -296,12 +296,15 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 }
 
 /*
- * Query request (UPIU type 0x16): set or clear one device flag. The query
+ * Query request (UPIU type 0x16): set or read one device flag. The query
  * response carries its result in the response byte of the UPIU header
- * (0 = QUERY_RESULT_SUCCESS).
+ * (0 = QUERY_RESULT_SUCCESS) and, for READ_FLAG, the flag value at offset
+ * 20. The request goes out with command type 1 (UFS storage), the value
+ * Linux sends on this host: with CT 2 the device answers INVALID_OPCODE.
+ * Returns 0 or an errno.
  */
 static int
-ufs_query_flag(uint8_t opcode, uint8_t idn)
+ufs_query_flag(uint8_t opcode, uint8_t idn, uint32_t *value)
 {
 	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
 	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
@@ -314,7 +317,7 @@ ufs_query_flag(uint8_t opcode, uint8_t idn)
 	ucd->cmd[3] = ++su.tag;
 	ucd->cmd[12] = opcode;                  /* 5 = READ_FLAG, 6 = SET_FLAG */
 	ucd->cmd[13] = idn;                     /* 1 = fDeviceInit */
-	utrd->dw0 = (2u << 28) | (1u << 24);    /* CT: device management, no data */
+	utrd->dw0 = (1u << 28) | (1u << 24);    /* CT: UFS storage (Linux), no data */
 	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
 	utrd->ucdba = (uint32_t)ucd_pa;
 	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
@@ -346,8 +349,18 @@ ufs_query_flag(uint8_t opcode, uint8_t idn)
 	if (ocs || ucd->resp[0] != 0x36 || ucd->resp[6]) {
 		printf("SWEET UFS: query 0x%x/0x%x failed: ocs 0x%x upiu 0x%x response 0x%x\n",
 		    opcode, idn, ocs, ucd->resp[0], ucd->resp[6]);
+		for (uint32_t row = 0; row < 3; row++) {
+			printf("SWEET UFS: qrsp %02x:", row * 16);
+			for (uint32_t i = 0; i < 16; i++) {
+				printf(" %02x", ucd->resp[row * 16 + i]);
+			}
+		}
 		return EIO;
 	}
+	if (value) {
+		*value = (uint32_t)ucd->resp[20] << 24 | (uint32_t)ucd->resp[21] << 16 |
+		    (uint32_t)ucd->resp[22] << 8 | ucd->resp[23];
+	}
 	return 0;
 }
 
@@ -366,7 +379,7 @@ ufs_wait_ready(void)
 	bool fdeviceinit = false;
 	int error = 0;
 
-	for (int i = 0; i < 100; i++) {
+	for (int i = 0; i < 200; i++) {
 		error = ufs_scsi(tur, sizeof(tur), 0, false);
 		if (!error) {
 			if (i) {
@@ -383,13 +396,30 @@ ufs_wait_ready(void)
 			return ENXIO;
 		}
 		/*
-		 * Still not ready after a second of polling: release UFS
-		 * device initialization (fDeviceInit) once, then keep polling.
+		 * Still not ready after a second of polling: the sense says
+		 * NOT READY/initializing command required (04/02), so release
+		 * UFS device initialization: set fDeviceInit and poll until
+		 * the device clears it (Linux ufshcd_complete_dev_init).
 		 */
 		if (i >= 10 && !fdeviceinit) {
+			uint32_t flag = 1;
+			int qerr = 0;
+
 			fdeviceinit = true;
-			printf("SWEET UFS: still not ready, setting fDeviceInit\n");
-			(void)ufs_query_flag(0x06, 0x01);
+			for (int r = 0; r < 3 && (qerr = ufs_query_flag(0x06, 0x01, NULL)); r++) {
+			}
+			if (qerr) {
+				printf("SWEET UFS: SET fDeviceInit failed, keep polling\n");
+			} else {
+				printf("SWEET UFS: fDeviceInit set, polling\n");
+				for (int m = 0; m < 1500; m++) {
+					if (ufs_query_flag(0x05, 0x01, &flag) || !flag) {
+						break;
+					}
+					delay(1000);            /* 1 ms */
+				}
+				printf("SWEET UFS: fDeviceInit now 0x%x\n", flag);
+			}
 		}
 		delay(100 * 1000);              /* 100 ms */
 	}
