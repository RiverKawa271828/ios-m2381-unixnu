diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 3ad743f..e044243 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -141,11 +141,39 @@ pe_init_fiq()
 		}
 	}
 
+#if defined(SWEET) || defined(M2381)
+	/*
+	 * No usable Group 0: on SWEET TrustZone owns it (two security states)
+	 * and non-secure writes to it are ignored; on M2381 there is a single
+	 * security state (GICD_TYPER.DS=1) but everything we own is still
+	 * Group 1, arriving as an IRQ (see sleh_irq). GICR_IGROUPR0 reads as
+	 * zero on SWEET even after this write; delivery still works.
+	 */
+#if defined(M2381)
+	/*
+	 * SM8550's GICv4.1 rejects writes to the SGI-page priorities with an
+	 * external abort (or silently drops them, depending on distributor
+	 * state) until "SGIs without active state" is enabled. The same order
+	 * as mainline Linux: gic_dist_init() sets nASSGIreq, gic_cpu_init()
+	 * writes these registers. Stage-0 probe verified both halves.
+	 */
+	gicd_write32(GICD_CTLR, gicd_read32(GICD_CTLR) | M2381_GICD_CTLR_NASSGIREQ);
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+#endif /* M2381 */
+	gicr_write32(GICR_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicr_write32(GICR_ISENABLER0, (1U << BOARD_VTIMER_INTID) | (1U << BOARD_IPI_SGI));
+#else
 	// Configure timers and legacy FIQ to be group 0
 	gicr_write32(GICR_IGROUPR0, 0x81FFFFFF);
 
 	// Enable PPI 27
 	gicr_write32(GICR_ISENABLER0, (1 << 27));
+#endif /* SWEET || M2381 */
 
 	// Enable system register access
 	uint64_t icc_sre = __builtin_arm_rsr64("ICC_SRE_EL1");
@@ -153,8 +181,12 @@ pe_init_fiq()
 	__builtin_arm_wsr64("ICC_SRE_EL1", icc_sre);
 	__builtin_arm_isb(ISB_SY);
 
+#if defined(SWEET) || defined(M2381)
+	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
+#else
 	// Set priority masks and binary point for group 0
 	__builtin_arm_wsr64("ICC_BPR0_EL1", 0);
+#endif /* SWEET || M2381 */
 	__builtin_arm_wsr64("ICC_PMR_EL1", 0xFF);
 
 	// Set EOI mode of this processor
@@ -162,12 +194,25 @@ pe_init_fiq()
 	icc_ctlr &= ~ICC_CTLR_EOIMODE;
 	__builtin_arm_wsr64("ICC_CTLR_EL1", icc_ctlr);
 
+#if defined(SWEET) || defined(M2381)
+	// ABL leaves only ARE_NS set; Linux writes ARE_NS | EnableGrp1A | EnableGrp1
+	// (on M2381's DS=1 distributor the same encodings stick, stage-0 probe)
+	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
+	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
+	gicd_write32(GICD_CTLR, gicd_ctlr);
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
+	__builtin_arm_isb(ISB_SY);
+#else
 	// Enable the forwarding of the vtimer interrupt
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
 	gicd_ctlr |= GICD_CTLR_ENABLEGRP0;
 	gicd_write32(GICD_CTLR, gicd_ctlr);
 	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 1);
 	__builtin_arm_isb(ISB_SY);
+#endif /* SWEET || M2381 */
 }
 #else
 void
diff --git a/pexpert/pexpert/arm64/M2381.h b/pexpert/pexpert/arm64/M2381.h
new file mode 100644
index 0000000..be23a14
--- /dev/null
+++ b/pexpert/pexpert/arm64/M2381.h
@@ -0,0 +1,102 @@
+/*
+ * Board config for the Meizu 20 / 20 Classic ("m2381", Qualcomm SM8550 /
+ * Snapdragon 8 Gen 2): 1x Cortex-X3 + 2x A715 + 2x A710 + 3x A510, ARMv9
+ * cores built as plain arm64 (no pointer authentication, like SWEET).
+ *
+ * Generic ARM like BCM2837 (no APPLE_ARM64_ARCH_FAMILY: none of Apple's
+ * implementation-defined system registers exist), 16K pages and GICv3 like
+ * VMAPPLE. Single security state (GICD_TYPER.DS=1, stage-0 probe): every
+ * interrupt, including the timer, is a Group 1 IRQ taken through sleh_irq().
+ * SM8550's GICv4.1 additionally requires GICD_CTLR.nASSGIreq before the
+ * SGI-page priority writes (see pe_init_fiq in pexpert/arm/pe_fiq.c).
+ *
+ * Every constant here was read back on the device by the stage-0 shim probe
+ * or comes from the Flyme stock FDT / mainline sm8550.dtsi (see
+ * NOTES-m2381.md in the porting workspace).
+ */
+
+#ifndef _PEXPERT_ARM64_M2381_H
+#define _PEXPERT_ARM64_M2381_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define M2381                     1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * Standard GICv3 PPI numbering (unlike SWEET's Qualcomm order): the virtual
+ * timer XNU uses (CNTV) is INTID 16 + 11 = 27, the physical timer 28. The
+ * stage-0 probe counted 30 vtimer expiries in 300ms on INTID 27.
+ */
+#define M2381_VTIMER_INTID        27
+#define M2381_IPI_SGI             1       // SGI used for cross-CPU signals
+
+/* All eight cores (3x A510 + 2x A715 + 2x A710 + 1x X3) as one homogeneous
+ * SMP cluster; PSCI CPU_ON to every core returned SUCCESS in stage 0. The
+ * scheduler does not know the big cores are faster (no AMP/P-E clusters).
+ * The cpus=N boot-arg selects the initial prefix (default 1, bring-up). */
+#define M2381_SMP_MAX_CPUS        8
+
+/*
+ * GICv4.1 "SGIs without active state" enable bit in GICD_CTLR. Until it is
+ * set (and RWP drained), writes to the SGI-page IPRIORITYR registers abort
+ * or are silently dropped. Mainline Linux sets it in gic_dist_init().
+ */
+#define M2381_GICD_CTLR_NASSGIREQ 0x100
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x40000 // Redistributor stride per PE (DT: 8 PEs in 0x200000)
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Single security state (DS=1); the NS-view encodings stick and behave. */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+/*
+ * Board-neutral aliases for code shared between SWEET and M2381.
+ */
+#define BOARD_FB_BASE             0xb8000000ULL   /* MDSS splash handoff (cont_splash_region) */
+#define BOARD_VTIMER_INTID        M2381_VTIMER_INTID
+#define BOARD_IPI_SGI             M2381_IPI_SGI
+#define BOARD_SMP_MAX_CPUS        M2381_SMP_MAX_CPUS
+
+#endif /* ! _PEXPERT_ARM64_M2381_H */
