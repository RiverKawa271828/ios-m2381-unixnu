+/*
+ * Task management request (UPIU type 0x04) through the task request list:
+ * one 80 byte UTMRD with the response embedded at DW12 (Linux struct
+ * utp_task_req_desc). LOGICAL UNIT RESET (function 0x08) is the SAM cure
+ * for sense 04/02 "initializing command required": the LU reinitializes
+ * and comes back ready. The TM service result lands in output_param1
+ * (0x0 = completed, 0x8 = succeeded). Returns 0 or an errno.
+ */
+static int
+ufs_tm(uint8_t func, uint8_t lun, uint32_t task_id, uint32_t *result)
+{
+	static bool taken;
+	uint32_t *tmrd = (uint32_t *)(su.dma + DMA_UTMR);
+	uint64_t tm_pa = su.dma_pa + DMA_UTMR;
+	uint8_t *p = (uint8_t *)tmrd;
+
+	if (!taken) {
+		taken = true;
+		ufs_wr(REG_UTMRLRSR, 0);
+		ufs_wr(REG_UTMRLBA, (uint32_t)tm_pa);
+		ufs_wr(REG_UTMRLBAU, (uint32_t)(tm_pa >> 32));
+		ufs_wr(REG_UTMRLRSR, 1);
+		if (ufs_rd(REG_UTMRLBA) != (uint32_t)tm_pa ||
+		    ufs_rd(REG_UTMRLBAU) != (uint32_t)(tm_pa >> 32) ||
+		    !(ufs_rd(REG_UTMRLRSR) & 1) || !(ufs_rd(REG_HCS) & HCS_TMREADY)) {
+			printf("SWEET UFS: host did not take our task list\n");
+			return EIO;
+		}
+	}
+
+	bzero(tmrd, 80);
+	tmrd[0] = 1u << 24;                     /* interrupt, command type 0 */
+	tmrd[2] = 0x0f;                         /* OCS invalid until updated */
+	p[16] = 0x04;                           /* TASK REQUEST UPIU */
+	p[18] = lun;
+	p[19] = ++su.tag;
+	p[21] = func;
+	p[31] = (uint8_t)lun;                   /* input_param1 = lun (BE32) */
+	p[32] = (uint8_t)(task_id >> 24);       /* input_param2 = task id */
+	p[33] = (uint8_t)(task_id >> 16);
+	p[34] = (uint8_t)(task_id >> 8);
+	p[35] = (uint8_t)task_id;
+
+	dma_sync(DMA_UTMR, 80);
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTMRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTMRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTMRLCLR, ~1u);
+			printf("SWEET UFS: task 0x%x timed out\n", func);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
+
+	dma_sync(DMA_UTMR, 80);
+
+	uint32_t ocs = tmrd[2] & 0xff;
+	if (ocs || p[48] != 0x24) {
+		printf("SWEET UFS: task 0x%x failed: ocs 0x%x upiu 0x%x\n",
+		    func, ocs, p[48]);
+		return EIO;
+	}
+	if (result) {
+		*result = (uint32_t)p[64] << 24 | (uint32_t)p[65] << 16 |
+		    (uint32_t)p[66] << 8 | p[67];
+	}
+	return 0;
+}
