+/*
+ * Query request (UPIU type 0x16): set or clear one device flag. The query
+ * response carries its result in the response byte of the UPIU header
+ * (0 = QUERY_RESULT_SUCCESS).
+ */
+static int
+ufs_query_flag(uint8_t opcode, uint8_t idn)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = 0x16;                     /* QUERY REQUEST UPIU */
+	ucd->cmd[2] = su.lun;
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[12] = opcode;                  /* 5 = READ_FLAG, 6 = SET_FLAG */
+	ucd->cmd[13] = idn;                     /* 1 = fDeviceInit */
+	utrd->dw0 = (2u << 28) | (1u << 24);    /* CT: device management, no data */
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("SWEET UFS: query 0x%x/0x%x timed out\n", opcode, idn);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x36 || ucd->resp[6]) {
+		printf("SWEET UFS: query 0x%x/0x%x failed: ocs 0x%x upiu 0x%x response 0x%x\n",
+		    opcode, idn, ocs, ucd->resp[0], ucd->resp[6]);
 		return EIO;
 	}
 	return 0;
 }
 
+/*
+ * Wait for LUN 0 to answer TEST UNIT READY. The device can reject the early
+ * commands with CHECK CONDITION while it comes up: a pending unit attention
+ * from the bootloader handover, a LU waking from standby, or UFS device
+ * initialization that stays incomplete until the host sets fDeviceInit.
+ * Three back-to-back retries all land within microseconds of the first one,
+ * so poll with a delay instead. Returns 0 or the last errno.
+ */
+static int
+ufs_wait_ready(void)
+{
+	static const uint8_t tur[6] = { 0x00 };
+	bool fdeviceinit = false;
+	int error = 0;
+
+	for (int i = 0; i < 100; i++) {
+		error = ufs_scsi(tur, sizeof(tur), 0, false);
+		if (!error) {
+			if (i) {
+				printf("SWEET UFS: LUN 0 ready after %d tries\n", i + 1);
+			}
+			return 0;
+		}
+		if (error != EBUSY) {
+			return error;           /* timeout or transport: hopeless */
+		}
+		if (ufs_sense_len >= 14 && ufs_sense_key == 0x5) {
+			printf("SWEET UFS: LUN 0 rejects commands (ILLEGAL REQUEST "
+			    "0x%02x/0x%02x)\n", ufs_sense_asc, ufs_sense_ascq);
+			return ENXIO;
+		}
+		/*
+		 * Still not ready after a second of polling: release UFS
+		 * device initialization (fDeviceInit) once, then keep polling.
+		 */
+		if (i >= 10 && !fdeviceinit) {
+			fdeviceinit = true;
+			printf("SWEET UFS: still not ready, setting fDeviceInit\n");
+			(void)ufs_query_flag(0x06, 0x01);
+		}
+		delay(100 * 1000);              /* 100 ms */
+	}
+	return error;
+}
