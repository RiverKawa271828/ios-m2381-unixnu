# Kernel configuration of the m2381 image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
# Schema v2 (2026-10-26): archive paths use the upstream component names
# (VirtioMmioBlock), the storage ABI comes from the static nx729j binding
# (build-storage-bindings.py → libStorageBindings.a, force-loaded below), and
# NATIVE_LEGACY_DISPLAY is off until the IOMobileFramebufferLegacy evidence
# stage exists (the v1 builder needed a staged display-analysis ABI audit;
# the display path runs through the UEFI GOP offline-legacy-* arguments).

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
# n while the full BootProgress diagnostic is out of the archive plan: its
# boot_progress_* call sites are strong references into libBootProgress.a.
# The no-op stub archive (force_loaded below) satisfies ShengUfs's weak
# boot_progress_poll — this ld64 errors on weak undefineds, unlike Apple's.
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
# n until the board-local GPU inputs exist: libAdreno740.a needs the
# ShengGmu*Source.h OPP/bandwidth policy (docs/porting/gpu.md; kept out of
# git upstream too) plus the .cache/firmware/sheng-gpu pinned blobs. Flip
# with the Adreno740 component/archive entries in one GPU topic.
CONFIG_XNU_NATIVE_ADRENO=n

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# The 21H461 donor image Data volume UUID - the same value fuxi/nx729j run
# for this exact build, and correct here as long as the userdata image is
# rebuilt from the same IPSW.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/virtio-mmio-block-verified-bundle/libVirtioMmioBlock.a"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
# The static storage ABI archive: absolute symbols for IOBlockStorageDevice's
# 190 dispatch slots, force-loaded next to the drivers that subclass it.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/io-storage-family/libStorageBindings.a -Wl,-force_load,{tree}/build/boot-progress-stub/libBootProgressStub.a"
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
