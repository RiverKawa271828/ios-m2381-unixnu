+
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+extern unsigned long vm_kernel_slide;
+extern void (*sheng_death_flush_hook)(void);
+
+/*
+ * Fileset emission: donor AppleMobileFileIntegrity's entitlements copy
+ * panics (OSEntitlements.cpp:863, "failed to create OSDictionary copy:
+ * 14") when the blob deserializer under the copy helper fails.
+ * Full chain (s96b RE on the 24A446 donor cache): the lambda at
+ * 0x925d014 reads the credential's blob at [x1+0xd0] and makes the
+ * single BL 0x925d040 -> 0x9264c90 (G). G walks blob+8 (H at
+ * 0x9263780: 40-byte header copy, 64-bit discriminator at blob+0x18,
+ * bitmap 0x381 fining types {0,7,8,9}) into the constructor K
+ * 0x92638d8, whose 32-bit type slot is [blob+0x8] -- the probe's
+ * "type" word -- and a switch miss there (observed: VA-shaped
+ * 0xce350bfa) returns NULL, reported as the hardcoded errno 14
+ * (mov w0, #0xe). H's discriminator PASSES (a miss would return 6,
+ * not 14), so the blob body is real and only its header slots are
+ * misplaced: the supplier side half-filled it. v2 rows bank the whole
+ * header and the victim identity. Bind the BL via the TEXT_WORD
+ * station (kits/XnuPrelink fileset_emit.py, donor VA 0xfffffe000925d040
+ * word 0x94001f14), call the original first so behavior is unchanged,
+ * and pull a synchronous log-window round (the sheng-death-flush hook)
+ * before the caller's panic freezes the writer.
+ * The original's live address is the collection VA plus vm_kernel_slide:
+ * the whole-collection rebase preserves donor-relative displacements and
+ * both halves of the hybrid image take the same boot slide.
+ */
+__attribute__((used, noinline))
+int
+unixnu_amfi_ent_copy_probe(void *holder, void *out)
+{
+	uintptr_t target = (uintptr_t)(0xfffffff009264c90ull + vm_kernel_slide);
+	int ret;
+
+	/* Plain blr: the helper lands on bti c and balances its own PAC
+	 * frame, so a raw-address call from this side is well-formed. */
+	{
+		register uintptr_t x0 __asm__("x0") = (uintptr_t)holder;
+		register uintptr_t x1 __asm__("x1") = (uintptr_t)out;
+		register uintptr_t x16 __asm__("x16") = target;
+
+		__asm__ volatile("blr x16"
+		    : "+r"(x0)
+		    : "r"(x1), "r"(x16)
+		    : "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+		    "x11", "x12", "x13", "x14", "x15", "x17", "x30", "memory");
+		ret = (int)x0;
+	}
+
+	if (ret != 0) {
+			/* Row 1 (r106-proven): the words G itself reads
+			 * (blob+8/+0x10/+0x20). */
+			kprintf("unixnu-amfi-entcopy: ret=%d holder=%p type=%llx tag=%llx shape=%llx\n",
+			    ret, holder,
+			    *(const unsigned long long *)((const char *)holder + 0x8),
+			    *(const unsigned long long *)((const char *)holder + 0x10),
+			    *(const unsigned long long *)((const char *)holder + 0x20));
+			if (sheng_death_flush_hook != NULL) {
+				sheng_death_flush_hook();
+			}
+			/* v2 rows (A14): one kprintf per read so one bad step
+			 * cannot take out the rows after it; the flush above
+			 * already banked the baseline row. +0x0 is the
+			 * container/isa word, +0x18 H's real 64-bit
+			 * discriminator, +0x28 the payload pointer G's
+			 * constructor consumes (print, never deref). */
+			kprintf("unixnu-amfi-entcopy: isa=%llx htag=%llx\n",
+			    *(const unsigned long long *)(const char *)holder,
+			    *(const unsigned long long *)((const char *)holder + 0x18));
+			kprintf("unixnu-amfi-entcopy: payload=%llx\n",
+			    *(const unsigned long long *)((const char *)holder + 0x28));
+			{
+				proc_t p = current_proc();
+
+				if (p != NULL) {
+					kprintf("unixnu-amfi-entcopy: victim pid=%d comm=%s\n",
+					    p->p_pid, p->p_comm);
+				}
+			}
+			if (sheng_death_flush_hook != NULL) {
+				sheng_death_flush_hook();
+			}
+	}
+	return ret;
+}
